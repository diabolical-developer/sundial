{
  "expo": {
    "name": "Sundial",
    "slug": "todo-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#17143A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sid.todo"
    },
    "android": {
      "package": "com.sid.todo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E2B6E"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FFC21A"
        }
      ]
    ]
  }
}
